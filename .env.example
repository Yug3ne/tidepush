# CLI configuration. Copy to .env (gitignored); bun loads it automatically.
TIDEPUSH_SERVER_URL=https://ota.example.com
# Create a token in the dashboard: Settings → API tokens.
TIDEPUSH_API_TOKEN=tp_replace_me
# The Expo app you publish from.
TIDEPUSH_APP_DIR=../my-expo-app
# Only needed if the server hostname is behind Cloudflare Access:
# TIDEPUSH_ACCESS_CLIENT_ID=
# TIDEPUSH_ACCESS_CLIENT_SECRET=
