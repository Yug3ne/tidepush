# CLI settings for a self-hosted server (or CI). Copy to .env (gitignored); bun loads it automatically.
# Hosted users don't need this: run `npx tidepush login` instead.
TIDEPUSH_SERVER_URL=https://ota.example.com
# Create a token in the web app: Settings → API tokens. (TIDEPUSH_API_TOKEN also works.)
TIDEPUSH_TOKEN=tp_replace_me
# The Expo app you publish from.
TIDEPUSH_APP_DIR=../my-expo-app
# Only needed when the server has several apps and the app's updates.url doesn't
# name one (https://…/<appId>/manifest). Same as --app.
# TIDEPUSH_APP_ID=app_xxxxxxxxxxxx
# Only needed if the API hostname's /admin path is behind Cloudflare Access:
# TIDEPUSH_ACCESS_CLIENT_ID=
# TIDEPUSH_ACCESS_CLIENT_SECRET=
