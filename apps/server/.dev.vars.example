# Local secrets for `wrangler dev`. Copy to .dev.vars (gitignored) and replace
# every value; these are placeholders, not working keys.

# Required. RSA private key PEM (PKCS#1 from `expo-updates codesigning:generate`, or PKCS#8).
CODE_SIGNING_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----"

# Required for first-run setup: unlocks creating the first owner at /setup.
# Generate with `openssl rand -hex 32`.
SETUP_TOKEN="dev-setup-token-replace-me-0123456789abcdef"

# Optional break-glass bearer tokens, comma-separated, >= 32 chars each.
# Normal API tokens (tp_…) are created in the dashboard.
ADMIN_API_TOKENS="dev-break-glass-token-replace-me-0123456789"
