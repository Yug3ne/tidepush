{
  "name": "@tidepush/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-file=/dev/null",
    "typegen:check": "wrangler types --check --env-file=/dev/null",
    "db:migrate:local": "wrangler d1 migrations apply tidepush --local",
    "db:migrate:remote": "wrangler d1 migrations apply tidepush --remote"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@tidepush/api": "workspace:*",
    "@tidepush/tsconfig": "workspace:*",
    "@types/node-forge": "^1.3.14",
    "node-forge": "^1.4.0",
    "typescript": "catalog:",
    "vitest": "^5.0.4",
    "wrangler": "catalog:"
  }
}
