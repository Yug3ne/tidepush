{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tidepush",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  // No account-specific ids: D1 is provisioned by name on the first deploy.
  // The R2 bucket must exist first: `wrangler r2 bucket create tidepush-assets`.
  "d1_databases": [{ "binding": "DB", "database_name": "tidepush", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "tidepush-assets" }],
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    // "hosted" turns on plan limits for orgs that aren't subscribed, and lets
    // anyone who signs up (through the web app) create an org. Leave it as
    // "selfhost" for a self-hosted deployment.
    "TIDEPUSH_MODE": "selfhost",
    // Email (invites, plan warnings) through Cloudflare Email Service. Set EMAIL_FROM to an address on a
    // domain onboarded with `wrangler email sending enable <domain>`; empty = no email, links are shown instead.
    "EMAIL_FROM": "",
    // The web app's public URL (apps/web, the dashboard): links in invite and plan emails,
    // and where this server's `/` redirects. Set it once the web app is deployed.
    "WEB_URL": "",
    // Must match updates.codeSigningMetadata.keyid in the app.
    "CODE_SIGNING_KEY_ID": "main"
  }
  // Secrets (`wrangler secret put <NAME>`; locally in .dev.vars, see .dev.vars.example):
  //   CODE_SIGNING_PRIVATE_KEY  required. PEM from `expo-updates codesigning:generate` (PKCS#1 or PKCS#8)
  //   SETUP_TOKEN               required for first-run setup (creating the first owner, at <web app>/setup).
  //                             Long random string.
  //   KEY_ENCRYPTION_KEY        recommended. `openssl rand -base64 32`. Encrypts each app's own signing key;
  //                             without it only the first app can sign (with CODE_SIGNING_PRIVATE_KEY).
  //                             Never change it once apps have keys.
  //   ADMIN_API_TOKENS          optional break-glass bearer tokens, comma-separated, >= 32 chars each.
  //                             Normal API tokens (tp_…) are created in the web app (Settings → API tokens).
  //
  // Custom domains (add your own, then redeploy):
  // "routes": [
  //   { "pattern": "ota.example.com", "custom_domain": true }
  // ]
}
