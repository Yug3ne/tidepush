{
  "extends": "@tidepush/tsconfig/base.json",
  "include": ["src", "vite.config.ts", "worker-configuration.d.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
