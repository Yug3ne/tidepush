---
// The landing page. Plain Astro, outside Starlight, so it ships no JavaScript beyond the
// inline theme script. The docs live in src/content/docs.
import "@fontsource/space-grotesk/latin-500.css";
import "@fontsource/space-grotesk/latin-600.css";
import "@fontsource/space-grotesk/latin-700.css";
import "@fontsource/nunito/latin-400.css";
import "@fontsource/nunito/latin-600.css";
import "@fontsource/nunito/latin-700.css";
import "@fontsource/source-code-pro/latin-500.css";
import "../styles/theme.css";
import logo from "../assets/logo.svg";
import ArchDiagram from "../components/ArchDiagram.astro";
import { nav, repo, signup } from "../components/links.ts";

const title = "Tidepush | OTA updates for Expo apps";
const description = "OTA updates for Expo apps. Signed, staged, instantly reversible.";

const features = [
  {
    title: "Stock expo-updates client",
    body: "Your app keeps the official expo-updates library. You only point updates.url at Tidepush.",
    icon: "M4 7h16M4 12h10M4 17h7",
  },
  {
    title: "Signed manifests",
    body: "Every manifest and rollback is signed with your app's own key. The app refuses anything unsigned or changed.",
    icon: "M12 3 5 6v5c0 4.5 3 8 7 10 4-2 7-5.5 7-10V6l-7-3Zm-3 9 2 2 4-4",
  },
  {
    title: "Staged rollouts",
    body: "Ship to 5% of devices, watch, then widen. Devices that already have the update keep it.",
    icon: "M4 19V5M4 19h16M8 15l3-4 3 2 5-6",
  },
  {
    title: "Instant rollback",
    body: "One command puts devices back on the previous update, or on the bundle built into the app.",
    icon: "M9 7H4V2M4.5 7A8 8 0 1 1 4 12",
  },
  {
    title: "Promote staging → production",
    body: "Test an update on staging builds, then promote the exact same files to production.",
    icon: "M5 12h14M13 6l6 6-6 6",
  },
  {
    title: "Adoption dashboard",
    body: "See which devices run which update and runtime, plus a full audit log of who did what.",
    icon: "M4 20V10M10 20V4M16 20v-7M22 20H2",
  },
  {
    title: "Teams & API tokens",
    body: "Organizations with owner, admin and read-only roles. Sign in with GitHub. Per-app tokens for CI.",
    icon: "M16 11a4 4 0 1 0-8 0M4 21a8 8 0 0 1 16 0M12 7v0",
  },
  {
    title: "Open source, no lock-in",
    body: "The same AGPL code runs the service. Export your signing key and run it yourself whenever you want.",
    icon: "M7 18a4 4 0 0 1-.5-8 6 6 0 0 1 11.5 1.5A3.5 3.5 0 0 1 17.5 18H7Z",
  },
];

const steps = [
  {
    n: "1",
    title: "You publish",
    body: "npx tidepush publish runs expo export, uploads only the files Tidepush doesn't have yet, and records a new update.",
  },
  {
    n: "2",
    title: "The app checks",
    body: "On launch, expo-updates asks Tidepush: “anything newer for my channel and runtime?”",
  },
  {
    n: "3",
    title: "The app updates",
    body: "It downloads the signed update in the background and runs it on the next launch.",
  },
];

const githubIcon =
  "M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z";
---

<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10263E" />
    <meta property="og:title" content="Tidepush" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={new URL("/", Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Same theme choice as the docs (Starlight stores it under this key). -->
    <script is:inline>
      const stored = localStorage.getItem("starlight-theme");
      const dark = stored === "dark" || (stored !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
      document.documentElement.dataset.theme = dark ? "dark" : "light";
    </script>
  </head>
  <body>
    <header class="tp-header">
      <div class="tp-wrap tp-header-row">
        <a class="tp-brand" href="/">
          <img src={logo.src} width="28" height="28" alt="" />
          Tidepush
        </a>
        <nav class="tp-nav" aria-label="Main">
          {nav.map((link) => <a href={link.href}>{link.label}</a>)}
          <a class="tp-nav-icon" href={repo} aria-label="GitHub">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path fill="currentColor" d={githubIcon} />
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <main class="tp-landing">
      <!-- Hero -->
      <section class="tp-hero">
        <div class="tp-wrap tp-hero-grid">
          <div class="tp-hero-text">
            <p class="tp-eyebrow"><span class="tp-dot"></span> Free to start · Open source</p>
            <h1>Tidepush</h1>
            <p class="tp-tagline">OTA updates for Expo apps. Signed, staged, instantly reversible.</p>
            <p class="tp-lead">
              Ship JavaScript fixes to your React Native app without waiting for a store review. Sign up, run one
              command in your app, and publish your first update in minutes.
            </p>
            <div class="tp-actions">
              <a class="tp-btn tp-btn-primary" href={signup}>Start free</a>
              <a class="tp-btn tp-btn-ghost" href="/guide/getting-started">Read the docs</a>
              <a class="tp-btn tp-btn-ghost" href={repo} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
                  />
                </svg>
                GitHub
              </a>
            </div>
          </div>

          <div class="tp-terminal" aria-label="Example: publishing an update with the CLI">
            <div class="tp-terminal-bar"><span></span><span></span><span></span></div>
            <pre><code><span class="tp-prompt">$</span> npx tidepush publish --channel production \
    -m "Fix fee copy on the send screen"
<span class="tp-dim">• Exporting ios + android bundle(s)…
• Reading app config and runtime version…
  ios      runtime 3f9c1a…  bundle 7.9 MB  42 assets
  android  runtime 3f9c1a…  bundle 8.1 MB  42 assets
• Uploading 2/86 files (16.0 MB)…</span>
<span class="tp-ok">✔ Published to production at 100% (group 7c1e0b52-…)</span>
<span class="tp-dim">  ios      9b0e6c1d-…
  android  4f2a8e77-…</span></code></pre>
          </div>
        </div>
      </section>

      <!-- What it is -->
      <section class="tp-section">
        <div class="tp-wrap tp-narrow">
          <h2>What it is</h2>
          <p class="tp-p">
            Tidepush is an update service that speaks the open{" "}
            <a href="https://docs.expo.dev/technical-specs/expo-updates-1/" target="_blank" rel="noopener">Expo Updates protocol</a>.
            Your app keeps using the official <code>expo-updates</code> library; you point it at Tidepush instead of
            Expo's service. You publish with a command-line tool, from your laptop or CI, and watch and control every
            release from the dashboard.
          </p>
        </div>
      </section>

      <!-- How it works -->
      <section class="tp-section tp-alt">
        <div class="tp-wrap">
          <h2>How it works</h2>
          <p class="tp-sub">One command to publish, one library you already use.</p>
          <div class="tp-how">
            <div class="tp-card tp-diagram"><ArchDiagram /></div>
            <ol class="tp-steps">
              {
                steps.map((s) => (
                  <li>
                    <span class="tp-step-n">{s.n}</span>
                    <div>
                      <h3>{s.title}</h3>
                      <p>{s.body}</p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>
          <p class="tp-more"><a href="/guide/how-it-works">Read the full request flow →</a></p>
        </div>
      </section>

      <!-- Features -->
      <section class="tp-section">
        <div class="tp-wrap">
          <h2>Features</h2>
          <p class="tp-sub">Everything you need to ship and undo JavaScript updates safely.</p>
          <div class="tp-grid">
            {
              features.map((f) => (
                <div class="tp-card tp-feature">
                  <span class="tp-icon">
                    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                      <path d={f.icon} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                  <h3>{f.title}</h3>
                  <p>{f.body}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Pricing -->
      <section class="tp-section tp-alt">
        <div class="tp-wrap tp-cost">
          <div>
            <h2>Pricing that follows your users</h2>
            <p class="tp-p">
              Start on the free plan, no card needed. Paid plans are priced by <strong>monthly active devices</strong>:
              installs that checked for an update that month. Not by downloads, and not by how often you publish.
            </p>
            <p class="tp-p tp-small">
              Going over your plan never stops updates reaching your users.{" "}
              <a href="/reference/limits">See plans and limits →</a>
            </p>
          </div>
          <div class="tp-card tp-price">
            <div class="tp-price-row"><span>Free plan</span><strong>No card</strong></div>
            <div class="tp-price-row"><span>Billed by</span><strong>Active devices</strong></div>
            <div class="tp-price-row"><span>Publishes &amp; downloads</span><strong>Unlimited</strong></div>
            <div class="tp-price-total"><span>Over your limit?</span><strong>Phones still update</strong></div>
          </div>
        </div>
      </section>

      <!-- Open source -->
      <section class="tp-section">
        <div class="tp-wrap tp-narrow tp-oss">
          <h2>Open source</h2>
          <p class="tp-p">
            The service runs the same code that's on GitHub, under the <strong>GNU AGPL-3.0</strong>. Teams that must keep
            keys and data on their own infrastructure can run it themselves, and you can export your signing key at any
            time. You're never locked in.
          </p>
          <div class="tp-actions tp-center">
            <a class="tp-btn tp-btn-ghost" href="/self-hosting">Self-hosting</a>
            <a class="tp-btn tp-btn-ghost" href={repo} target="_blank" rel="noopener">Source on GitHub</a>
          </div>
        </div>
      </section>

      <section class="tp-section tp-cta">
        <div class="tp-wrap tp-narrow">
          <h2>Ship your first update in 20 minutes</h2>
          <p class="tp-p">Sign up, run <code>npx tidepush init</code> in your app, build once, publish.</p>
          <div class="tp-actions tp-center">
            <a class="tp-btn tp-btn-primary" href={signup}>Start free</a>
            <a class="tp-btn tp-btn-on-navy" href="/guide/getting-started">Follow the tutorial</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="tp-footer">
      <p>Released under the AGPL-3.0-only license. Commercial licenses available.</p>
      <p>Copyright © Eugene Koech</p>
    </footer>
  </body>
</html>

<style>
:global(*, *::before, *::after) {
  box-sizing: border-box;
}
:global(body) {
  margin: 0;
  background: var(--tp-bg);
  color: var(--tp-text-1);
  font-family: var(--tp-font-base);
  -webkit-font-smoothing: antialiased;
}
:global(html) {
  color-scheme: light;
}
:global(html[data-theme="dark"]) {
  color-scheme: dark;
}

/* Header and footer */
.tp-header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--tp-surface);
  border-bottom: 1px solid var(--tp-divider);
}
.tp-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 64px;
}
.tp-brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--tp-text-1);
  font-family: var(--tp-font-heading);
  font-size: 18px;
  font-weight: 700;
  text-decoration: none;
}
.tp-nav {
  display: flex;
  align-items: center;
  gap: 24px;
  font-family: var(--tp-font-heading);
  font-size: 14px;
  font-weight: 500;
}
.tp-nav a {
  color: var(--tp-text-2);
  text-decoration: none;
}
.tp-nav a:hover {
  color: var(--tp-brand);
}
.tp-nav-icon {
  display: inline-flex;
}
.tp-footer {
  padding: 32px 24px;
  border-top: 1px solid var(--tp-divider);
  text-align: center;
  font-size: 14px;
  color: var(--tp-text-2);
}
.tp-footer p {
  margin: 4px 0;
}
@media (max-width: 640px) {
  .tp-nav a:not(.tp-nav-icon) {
    display: none;
  }
}
.tp-landing {
  background: var(--tp-bg);
  color: var(--tp-text-1);
  font-family: var(--tp-font-base);
}
.tp-wrap {
  max-width: 1152px;
  margin: 0 auto;
  padding: 0 24px;
}
.tp-narrow {
  max-width: 760px;
  text-align: center;
}
.tp-section {
  padding: 72px 0;
  border-top: 1px solid var(--tp-divider);
}
.tp-alt {
  background: var(--tp-surface);
}
h1,
h2,
h3 {
  font-family: var(--tp-font-heading);
  color: var(--tp-text-1);
  letter-spacing: -0.02em;
}
h2 {
  font-size: 32px;
  line-height: 1.2;
  font-weight: 700;
  margin: 0 0 12px;
}
h3 {
  font-size: 17px;
  font-weight: 600;
  margin: 0 0 6px;
}
.tp-sub {
  color: var(--tp-text-2);
  margin: 0 0 32px;
  font-size: 17px;
}
.tp-p {
  color: var(--tp-text-2);
  font-size: 17px;
  line-height: 1.7;
  margin: 0 0 16px;
}
.tp-p a,
.tp-more a {
  color: var(--tp-brand);
  font-weight: 600;
}
.tp-p code {
  font-family: var(--tp-font-mono);
  font-size: 0.9em;
  background: var(--tp-input);
  padding: 2px 6px;
  border-radius: 6px;
}
.tp-small {
  font-size: 15px;
}

/* Hero */
.tp-hero {
  padding: 80px 0 72px;
}
.tp-hero-grid {
  display: grid;
  grid-template-columns: 1.05fr 1fr;
  gap: 48px;
  align-items: center;
}
.tp-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin: 0 0 20px;
  padding: 6px 12px;
  border-radius: 999px;
  background: var(--tp-accent-tint);
  color: var(--tp-brand);
  font-family: var(--tp-font-heading);
  font-size: 13px;
  font-weight: 600;
}
.tp-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--tp-accent);
}
.tp-hero h1 {
  font-size: 64px;
  line-height: 1;
  font-weight: 700;
  margin: 0 0 16px;
}
.tp-tagline {
  font-family: var(--tp-font-heading);
  font-size: 26px;
  line-height: 1.3;
  font-weight: 500;
  color: var(--tp-text-1);
  margin: 0 0 16px;
}
.tp-lead {
  font-size: 18px;
  line-height: 1.65;
  color: var(--tp-text-2);
  margin: 0 0 28px;
  max-width: 520px;
}
.tp-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}
.tp-center {
  justify-content: center;
  margin-top: 8px;
}
.tp-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 22px;
  border-radius: var(--tp-radius-btn);
  font-family: var(--tp-font-heading);
  font-weight: 600;
  font-size: 16px;
  text-decoration: none;
  border: 1.5px solid transparent;
  transition: background-color 0.15s, border-color 0.15s;
}
.tp-btn-primary {
  background: var(--tp-accent);
  color: var(--tp-on-accent);
}
.tp-btn-primary:hover {
  background: var(--tp-accent-dark);
}
.tp-btn-ghost {
  background: var(--tp-surface);
  color: var(--tp-text-1);
  border-color: var(--tp-border);
}
.tp-btn-ghost:hover {
  border-color: var(--tp-text-3);
}
.tp-btn-on-navy {
  color: #ffffff;
  border-color: #ffffff40;
}
.tp-btn-on-navy:hover {
  border-color: #ffffff;
}

.tp-terminal {
  background: #10263e;
  border-radius: var(--tp-radius-card);
  overflow: hidden;
  border: 1px solid #1a3a5c;
}
:global([data-theme="dark"]) .tp-terminal {
  background: #15201c;
  border-color: #22302a;
}
.tp-terminal-bar {
  display: flex;
  gap: 6px;
  padding: 14px 16px 0;
}
.tp-terminal-bar span {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #ffffff26;
}
.tp-terminal pre {
  margin: 0;
  padding: 16px 20px 22px;
  overflow-x: auto;
  font-family: var(--tp-font-mono);
  font-size: 13px;
  line-height: 1.7;
  color: #ffffff;
}
.tp-prompt {
  color: #18d26e;
}
.tp-dim {
  color: #c3cec8;
  opacity: 0.8;
}
.tp-ok {
  color: #18d26e;
  font-weight: 600;
}

/* Cards */
.tp-card {
  background: var(--tp-surface);
  border: 1px solid var(--tp-border);
  border-radius: var(--tp-radius-card);
}
.tp-alt .tp-card {
  background: var(--tp-bg);
}

/* How */
.tp-how {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 32px;
  align-items: center;
}
.tp-diagram {
  padding: 20px;
}
.tp-steps {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 24px;
}
.tp-steps li {
  display: flex;
  gap: 16px;
}
.tp-steps p {
  margin: 0;
  color: var(--tp-text-2);
  line-height: 1.6;
}
.tp-step-n {
  flex: none;
  width: 34px;
  height: 34px;
  border-radius: 10px;
  display: grid;
  place-items: center;
  background: var(--tp-accent-tint);
  color: var(--tp-brand);
  font-family: var(--tp-font-heading);
  font-weight: 700;
}
.tp-more {
  margin: 28px 0 0;
}

/* Features */
.tp-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}
.tp-feature {
  padding: 24px;
}
.tp-feature p {
  margin: 0;
  color: var(--tp-text-2);
  font-size: 15px;
  line-height: 1.6;
}
.tp-icon {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  margin-bottom: 16px;
  border-radius: 12px;
  background: var(--tp-accent-tint);
  color: var(--tp-brand);
}

/* Cost */
.tp-cost {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 48px;
  align-items: center;
}
.tp-price {
  padding: 8px 24px;
}
.tp-price-row,
.tp-price-total {
  display: flex;
  justify-content: space-between;
  padding: 16px 0;
  border-bottom: 1px solid var(--tp-divider);
  color: var(--tp-text-2);
}
.tp-price strong {
  font-family: var(--tp-font-heading);
  color: var(--tp-text-1);
}
.tp-price-total {
  border-bottom: 0;
}
.tp-price-total span {
  color: var(--tp-text-1);
  font-weight: 700;
}
.tp-price-total strong {
  color: var(--tp-brand);
  font-size: 18px;
}

/* CTA */
.tp-cta {
  background: #10263e;
  border-top: 0;
}
:global([data-theme="dark"]) .tp-cta {
  background: #15201c;
  border-top: 1px solid var(--tp-divider);
}
.tp-cta h2 {
  color: #ffffff;
}
.tp-cta .tp-p {
  color: #c3cec8;
}

@media (max-width: 960px) {
  .tp-hero-grid,
  .tp-how,
  .tp-cost {
    grid-template-columns: 1fr;
  }
  .tp-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 560px) {
  .tp-hero {
    padding-top: 48px;
  }
  .tp-hero h1 {
    font-size: 48px;
  }
  .tp-tagline {
    font-size: 21px;
  }
  .tp-grid {
