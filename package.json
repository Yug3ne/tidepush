{
  "name": "tidepush",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@fontsource/nunito": "^5.3.0",
      "@fontsource/source-code-pro": "^5.3.1",
      "@fontsource/space-grotesk": "^5.3.0",
      "typescript": "^7.0.2",
      "wrangler": "^4.151.0",
      "zod": "^4.6.7"
    }
  },
  "scripts": {
    "dev": "turbo run dev --filter=@tidepush/server --filter=@tidepush/web",
    "build": "turbo run build",
    "deploy": "turbo run deploy --filter=@tidepush/server --filter=@tidepush/web",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "tidepush": "bun packages/cli/src/index.ts",
    "website:dev": "turbo run dev --filter=@tidepush/website",
    "website:build": "turbo run build --filter=@tidepush/website"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  },
  "license": "AGPL-3.0-only"
}
